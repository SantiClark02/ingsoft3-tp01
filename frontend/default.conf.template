server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA: cualquier ruta que no sea un archivo real
    # devuelve index.html para que React Router la resuelva.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # TP6: la dirección del backend NO está escrita en la imagen.
    # Esto es una PLANTILLA: la imagen oficial de nginx reemplaza ${BACKEND_URL}
    # y ${DNS_RESOLVER} con las variables de entorno al arrancar el contenedor.
    # Así la MISMA imagen sirve en cualquier entorno: cada uno le pasa su backend.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        # /api/activities llega al backend como /activities
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_api;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
